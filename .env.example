# ── Hardhat / Deploy config (never commit actual values) ──────────────────────

# Ethereum Sepolia RPC Endpoint (from QuickNode, Infura, or Alchemy)
SEPOLIA_RPC_URL=https://sepolia.quicknode.pro/your-api-key-here

# Private key for the deployer / owner wallet (burner wallet only — never your main wallet)
SEPOLIA_PRIVATE_KEY=0xyour_private_key_here

# ── Frontend environment (prefix NEXT_PUBLIC_ to expose to the browser) ───────

# WalletConnect Project ID — get yours free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here